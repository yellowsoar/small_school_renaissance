# Copy to .env and edit. .env is gitignored; this file is the documented default.
#   cp .env.example .env
# Every value below is optional — the app runs with none of them set.

# ─────────────────────────────────────────────────────────────────────────────
# Dataset source
# ─────────────────────────────────────────────────────────────────────────────
# scripts/fetch-data.js downloads the school CSV into public/data/ before dev
# and build. The CSV is upstream data, not source code, so it is gitignored and
# re-fetched instead of committed.
#
# The URL is assembled as:
#   https://raw.githubusercontent.com/${DATA_OWNER}/${DATA_REPO}/${DATA_BRANCH}/${DATA_PATH}

# GitHub org or user hosting the dataset.
# Default: g0v — yellowsoar/small_school_renaissance does not carry the CSV yet.
DATA_OWNER=g0v

# Repository name holding the dataset.
DATA_REPO=small_school_renaissance

# Branch to read the dataset from.
DATA_BRANCH=gh-pages

# Path to the CSV inside that repo.
DATA_PATH=docs/113-107.csv

# Full override. When set, the four variables above are ignored entirely.
# Use this for a local file server, a CDN, or an internal mirror.
# DATA_SOURCE_URL=http://localhost:8080/113-107.csv

# ─────────────────────────────────────────────────────────────────────────────
# Build
# ─────────────────────────────────────────────────────────────────────────────
# Public base path of the production build. GitHub Pages project sites live
# under /<repo-name>/. Set to / for a custom domain or root deployment.
# Ignored by `npm run dev`, which always serves from /.
BASE_PATH=/small_school_renaissance/
